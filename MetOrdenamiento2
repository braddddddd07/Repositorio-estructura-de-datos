class NumeroDato:

  def __init__(self, texto, valor):
    self.texto = texto
    self.valor = float(valor)

  def __lt__(self, other):
    return self.valor < other.valor

  def __le__(self, other):
    return self.valor <= other.valor

  def __gt__(self, other):
    return self.valor > other.valor

  def __ge__(self, other):
    return self.valor >= other.valor

  def __eq__(self, other):
    if isinstance(other, NumeroDato):
      return math.isclose(self.valor, other.valor, rel_tol=1e-9, abs_tol=1e-9)
    return False

  def __str__(self):
    return self.texto

  def __repr__(self):
    return self.texto


def fmt(num):
  if "/" in num.texto or "√" in num.texto or "sqrt" in num.texto.lower() or "raiz" in num.texto.lower():
    return f"{num.texto} (≈{num.valor:.3f})"
  return num.texto


def parsear_numero(token):
  original = token.strip()
  if not original:
    raise ValueError("Elemento vacío.")

  expr = original.lower().replace(" ", "")
  expr = expr.replace("raiz", "sqrt")
  expr = re.sub(r"√\s*\(", "sqrt(", expr)
  expr = re.sub(r"√\s*(\d+(?:\.\d+)?)", r"sqrt(\1)", expr)

  if "√" in expr:
    raise ValueError(f"Formato de raíz inválido en '{original}'.")

  expr = re.sub(r"(\d|\))\s*(sqrt|\()", r"\1*\2", expr)

  limpio = expr.replace("sqrt", "")
  if not re.fullmatch(r"[0-9\.\+\-\*\/\(\)]+", limpio):
    raise ValueError(
        f"Valor no reconocido: '{original}'.\n"
        "Usa enteros, negativos, fracciones (ej. -3/4) o raíces (ej. √5, -sqrt(2))."
    )

  try:
    valor = eval(expr, {"__builtins__": None}, {"sqrt": math.sqrt})
  except ZeroDivisionError:
    raise ValueError(f"División entre cero en '{original}'.")
  except ValueError:
    raise ValueError(f"No se permiten raíces de números negativos en '{original}'.")
  except Exception:
    raise ValueError(f"Expresión numérica inválida: '{original}'.")

  if not isinstance(valor, (int, float)) or math.isnan(valor) or math.isinf(valor):
    raise ValueError(f"Valor fuera de rango en '{original}'.")

  return NumeroDato(original, float(valor))


def generar_pasos_shell(arr):
  a = arr.copy()
  n = len(a)
  pasos = []

  pasos.append({
      "array": a.copy(),
      "colores": {},
      "texto": f"Estado inicial: Arreglo de {n} elementos listo para ordenar con ShellSort.",
      "info": "Gap actual: N/A",
  })

  gap = n // 2
  while gap > 0:
    pasos.append({
        "array": a.copy(),
        "colores": {},
        "texto": f"Nuevo intervalo (gap) = {gap}. Se compararán elementos separados por {gap} posiciones.",
        "info": f"Gap actual: {gap}",
    })

    for i in range(gap, n):
      temp = a[i]
      j = i

      pasos.append({
          "array": a.copy(),
          "colores": {i: "#8b5cf6"},
          "texto": f"Seleccionado elemento a[{i}] = {fmt(temp)} para insertarlo en su sublista con salto {gap}.",
          "info": f"Gap actual: {gap} | Pivote: {temp}",
      })

      desplazo = False
      while j >= gap and a[j - gap] > temp:
        pasos.append({
            "array": a.copy(),
            "colores": {j - gap: "#f59e0b", j: "#ef4444"},
            "texto": (
                f"Comparando a[{j - gap}] ({fmt(a[j - gap])}) > {fmt(temp)}: "
                f"Como es mayor, se desplaza {a[j - gap]} a la posición [{j}]."
            ),
            "info": f"Gap actual: {gap}",
        })
        a[j] = a[j - gap]
        j -= gap
        desplazo = True

      if j >= gap:
        pasos.append({
            "array": a.copy(),
            "colores": {j - gap: "#f59e0b", j: "#8b5cf6"},
            "texto": f"Comparando a[{j - gap}] ({fmt(a[j - gap])}) <= {fmt(temp)}: No requiere más desplazamientos.",
            "info": f"Gap actual: {gap}",
        })

      a[j] = temp
      if desplazo:
        pasos.append({
            "array": a.copy(),
            "colores": {j: "#10b981"},
            "texto": f"Se coloca el valor {fmt(temp)} en la posición [{j}].",
            "info": f"Gap actual: {gap}",
        })

    gap //= 2

  pasos.append({
      "array": a.copy(),
      "colores": {idx: "#10b981" for idx in range(n)},
      "texto": "¡Ordenamiento completado! Todos los elementos están ordenados con ShellSort.",
      "info": "Gap final: 0 (Completado)",
  })
  return pasos


def generar_pasos_quicksort(arr):
  a = arr.copy()
  n = len(a)
  pasos = []
  ordenados = set()

  pasos.append({
      "array": a.copy(),
      "colores": {},
      "texto": f"Estado inicial: Arreglo de {n} elementos listo para ordenar con Quicksort.",
      "info": "Subarreglo activo: Todo el arreglo",
  })

  def colorear(extra=None):
    c = {idx: "#10b981" for idx in ordenados}
    if extra:
      c.update(extra)
    return c

  def particionar(low, high):
    pivote = a[high]
    pasos.append({
        "array": a.copy(),
        "colores": colorear({high: "#8b5cf6"}),
        "texto": f"Subarreglo [{low}..{high}]: Se elige como pivote a[{high}] = {fmt(pivote)}.",
        "info": f"Rango: [{low}..{high}] | Pivote: {pivote}",
    })

    i = low - 1
    for j in range(low, high):
      pasos.append({
          "array": a.copy(),
          "colores": colorear({high: "#8b5cf6", j: "#f59e0b"}),
          "texto": f"Comparando a[{j}] ({fmt(a[j])}) con el pivote ({fmt(pivote)}).",
          "info": f"Rango: [{low}..{high}] | Pivote: {pivote}",
      })

      if a[j] <= pivote:
        i += 1
        if i != j:
          a[i], a[j] = a[j], a[i]
          pasos.append({
              "array": a.copy(),
              "colores": colorear({high: "#8b5cf6", i: "#ef4444", j: "#ef4444"}),
              "texto": f"{fmt(a[i])} <= {fmt(pivote)}: Se intercambian a[{i}] ({a[i]}) y a[{j}] ({a[j]}).",
              "info": f"Rango: [{low}..{high}] | Pivote: {pivote}",
          })
        else:
          pasos.append({
              "array": a.copy(),
              "colores": colorear({high: "#8b5cf6", i: "#3b82f6"}),
              "texto": f"{fmt(a[j])} <= {fmt(pivote)}: Permanece en la zona de menores (índice [{i}]).",
              "info": f"Rango: [{low}..{high}] | Pivote: {pivote}",
          })

    if i + 1 != high:
      a[i + 1], a[high] = a[high], a[i + 1]
    p_idx = i + 1
    ordenados.add(p_idx)
    pasos.append({
        "array": a.copy(),
        "colores": colorear({p_idx: "#10b981"}),
        "texto": (
            f"El pivote {fmt(pivote)} se coloca en su posición definitiva [{p_idx}]. "
            "Menores a la izquierda, mayores a la derecha."
        ),
        "info": f"Pivote fijado en índice [{p_idx}]",
    })
    return p_idx

  def qs(low, high):
    if low < high:
      pi = particionar(low, high)
      qs(low, pi - 1)
      qs(pi + 1, high)
    elif low == high and low not in ordenados:
      ordenados.add(low)
      pasos.append({
          "array": a.copy(),
          "colores": colorear(),
          "texto": f"El elemento único a[{low}] ({fmt(a[low])}) queda en su posición definitiva.",
          "info": f"Índice fijado: [{low}]",
      })

  qs(0, n - 1)

  pasos.append({
      "array": a.copy(),
      "colores": {idx: "#10b981" for idx in range(n)},
      "texto": "¡Ordenamiento completado! Todos los pivotes y particiones están ordenados.",
      "info": "Completado",
  })
  return pasos


def generar_pasos_heapsort(arr):
  a = arr.copy()
  n = len(a)
  pasos = []
  ordenados = set()

  pasos.append({
      "array": a.copy(),
      "colores": {},
      "texto": f"Estado inicial: Arreglo de {n} elementos listo para construir un Max-Heap.",
      "info": "Fase: Inicialización",
  })

  def colorear(extra=None):
    c = {idx: "#10b981" for idx in ordenados}
    if extra:
      c.update(extra)
    return c

  def heapify(tam, i, fase):
    largest = i
    left = 2 * i + 1
    right = 2 * i + 2

    comparados = {i: "#8b5cf6"}
    if left < tam:
      comparados[left] = "#f59e0b"
    if right < tam:
      comparados[right] = "#f59e0b"

    if left < tam or right < tam:
      hijos_txt = []
      if left < tam:
        hijos_txt.append(f"izq a[{left}]={fmt(a[left])}")
      if right < tam:
        hijos_txt.append(f"der a[{right}]={fmt(a[right])}")
      pasos.append({
          "array": a.copy(),
          "colores": colorear(comparados),
          "texto": f"{fase}: Comparando padre a[{i}]={fmt(a[i])} con hijos ({', '.join(hijos_txt)}).",
          "info": f"Tamaño del Heap activo: {tam}",
      })

    if left < tam and a[left] > a[largest]:
      largest = left
    if right < tam and a[right] > a[largest]:
      largest = right

    if largest != i:
      a[i], a[largest] = a[largest], a[i]
      pasos.append({
          "array": a.copy(),
          "colores": colorear({i: "#ef4444", largest: "#ef4444"}),
          "texto": (
              f"{fase}: El hijo ({fmt(a[i])}) era mayor que el padre ({fmt(a[largest])}). "
              f"Se intercambian posiciones [{i}] y [{largest}]."
          ),
          "info": f"Tamaño del Heap activo: {tam}",
      })
      heapify(tam, largest, fase)

  for i in range(n // 2 - 1, -1, -1):
    heapify(n, i, "Fase 1 (Construir Max-Heap)")

  pasos.append({
      "array": a.copy(),
      "colores": colorear({0: "#8b5cf6"}),
      "texto": f"Max-Heap construido: El elemento mayor ({fmt(a[0])}) está en la raíz [0].",
      "info": "Max-Heap listo",
  })

  for i in range(n - 1, 0, -1):
    a[i], a[0] = a[0], a[i]
    ordenados.add(i)
    pasos.append({
        "array": a.copy(),
        "colores": colorear({0: "#ef4444", i: "#10b981"}),
        "texto": (
            f"Fase 2 (Extracción): Se intercambia la raíz máxima ({fmt(a[i])}) con el final [{i}]. "
            f"El valor {a[i]} queda ordenado."
        ),
        "info": f"Tamaño del Heap activo: {i}",
    })
    heapify(i, 0, "Fase 2 (Reajustar Heap)")

  ordenados.add(0)
  pasos.append({
      "array": a.copy(),
      "colores": {idx: "#10b981" for idx in range(n)},
      "texto": "¡Ordenamiento completado! Todos los elementos fueron extraídos del montículo.",
      "info": "Completado",
  })
  return pasos


def generar_pasos_radix(arr):
  a = arr.copy()
  n = len(a)
  pasos = []
  hay_negativos = any(x.valor < 0 for x in a)
  rango_cubetas = range(-9, 10) if hay_negativos else range(0, 10)

  if all(float(x.valor).is_integer() for x in a):
    decimales = 0
  else:
    decimales = 3
    for d in [1, 2, 3, 4]:
      ok = True
      for i in range(n):
        for j in range(i + 1, n):
          if a[i] != a[j] and round(a[i].valor * (10**d)) == round(a[j].valor * (10**d)):
            ok = False
            break
        if not ok:
          break
      if ok:
        decimales = d
        break

  escala = 10**decimales

  pasos.append({
      "array": a.copy(),
      "colores": {},
      "texto": (
          f"Estado inicial: {n} elementos listos para Radix Sort"
          + (f" (precisión de {decimales} decimales para fracciones/raíces)." if decimales > 0 else ".")
      ),
      "info": "Pasada: Inicialización",
      "cubetas": {k: [] for k in rango_cubetas},
  })

  enteros_esc = [int(round(x.valor * escala)) for x in a]
  max_abs = max(abs(v) for v in enteros_esc) if enteros_esc else 0
  exp = 1

  nombres_potencia = {
      -4: "Diezmilésimas (10⁻⁴)",
      -3: "Milésimas (10⁻³)",
      -2: "Centésimas (10⁻²)",
      -1: "Décimas (10⁻¹)",
      0: "Unidades (10⁰)",
      1: "Decenas (10¹)",
      2: "Centenas (10²)",
      3: "Millares (10³)",
      4: "Decenas de millar (10⁴)",
  }

  if max_abs == 0:
    pasos.append({
        "array": a.copy(),
        "colores": {idx: "#10b981" for idx in range(n)},
        "texto": "¡Ordenamiento completado!",
        "info": "Completado",
        "cubetas": {k: [] for k in rango_cubetas},
    })
    return pasos

  while max_abs // exp > 0:
    pot = round(math.log10(exp)) - decimales
    etiqueta_pos = nombres_potencia.get(pot, f"Posición 10^{pot}")
    cubetas = {k: [] for k in rango_cubetas}

    for idx, item in enumerate(a):
      val_int = int(round(item.valor * escala))
      digito = -(abs(val_int) // exp % 10) if val_int < 0 else (val_int // exp) % 10
      cubetas[digito].append(item)
      pasos.append({
          "array": a.copy(),
          "colores": {idx: "#8b5cf6"},
          "texto": (
              f"Analizando {etiqueta_pos}: {fmt(item)} tiene dígito ({digito}) "
              f"-> Se envía a la cubeta [{digito}]."
          ),
          "info": f"Pasada actual: {etiqueta_pos}",
          "cubetas": {k: v.copy() for k, v in cubetas.items()},
      })

    nuevo_a = []
    for k in rango_cubetas:
      nuevo_a.extend(cubetas[k])

    a = nuevo_a
    pasos.append({
        "array": a.copy(),
        "colores": {idx: "#f59e0b" for idx in range(n)},
        "texto": (
            f"Recolección de cubetas ({etiqueta_pos}): Se extraen los elementos "
            "desde la primera cubeta hasta la última."
        ),
        "info": f"Fin de pasada: {etiqueta_pos}",
        "cubetas": {k: v.copy() for k, v in cubetas.items()},
    })

    exp *= 10

  pasos.append({
      "array": a.copy(),
      "colores": {idx: "#10b981" for idx in range(n)},
      "texto": "¡Ordenamiento completado! Todas las cifras posicionales fueron procesadas.",
      "info": "Completado",
      "cubetas": {k: [] for k in rango_cubetas},
  })
  return pasos


