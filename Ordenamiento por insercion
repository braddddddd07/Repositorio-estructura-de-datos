import tkinter as tk
import random
import time

ordenando = False

def generar_arreglo():
    global datos, ordenando
    ordenando = False 
    datos = [random.randint(10, 100) for _ in range(25)]
    dibujar_datos(datos, ['#6495ED' for _ in range(len(datos))])

def dibujar_datos(datos, colores):
    canvas.delete("all")
    c_width, c_height = 600, 400
    x_width = c_width / (len(datos) + 1)
    offset, spacing = 20, 5
    max_val = max(datos)
    for i, val in enumerate(datos):
        x0 = i * x_width + offset + spacing
        y0 = c_height - (val / max_val) * 350
        x1 = (i + 1) * x_width + offset
        y1 = c_height
        canvas.create_rectangle(x0, y0, x1, y1, fill=colores[i])
    root.update()

def ordenar_insercion():
    global datos, ordenando
    if ordenando:
        return
    ordenando = True
    for i in range(1, len(datos)):
        if not ordenando:
            return
        key = datos[i]
        j = i - 1
        while j >= 0 and key < datos[j]:
            if not ordenando:
                return
            datos[j + 1] = datos[j]
            j -= 1
            colores = ['#FFA500' if x == j+1 or x == i else '#6495ED' for x in range(len(datos))]
            dibujar_datos(datos, colores)
            time.sleep(0.02)
        datos[j + 1] = key
        if not ordenando:
            return
        dibujar_datos(datos, ['#32CD32' if x <= i else '#6495ED' for x in range(len(datos))])
        time.sleep(0.05)
    if ordenando:
        dibujar_datos(datos, ['#32CD32' for _ in range(len(datos))])
        ordenando = False

root = tk.Tk()
root.title("Ordenamiento por Inserción - Con detención")
datos = []
frame = tk.Frame(root)
frame.pack(pady=10)

tk.Button(frame, text="Generar Arreglo", command=generar_arreglo).grid(row=0, column=0, padx=10)
tk.Button(frame, text="Ordenar (Inserción)", command=ordenar_insercion).grid(row=0, column=1, padx=10)

canvas = tk.Canvas(root, width=600, height=400, bg="white")
canvas.pack()

generar_arreglo()
root.mainloop()
