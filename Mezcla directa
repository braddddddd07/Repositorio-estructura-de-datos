import tkinter as tk
from tkinter import ttk, messagebox
import random
import time


class AppMezclaDirecta:
    def __init__(self, root):
        self.root = root
        self.root.title("Ejercicio 2: Ordenamiento por Mezcla Directa")
        self.root.geometry("980x680")
        self.root.minsize(900, 620)
        self.root.configure(bg="#0f172a")

        self.pasos = []
        self.indice_paso = 0
        self.ejecutando_auto = False
        self.after_id = None
        self.tiempo_ms = 0.0

        self.construir_interfaz()
        self.cargar_ejemplo()

    def construir_interfaz(self):
        header = tk.Frame(self.root, bg="#1e293b", pady=12, padx=20)
        header.pack(fill="x")

        tk.Label(
            header,
            text="EJERCICIO 2: MEZCLA DIRECTA (DIRECT MERGE)",
            font=("Segoe UI", 15, "bold"),
            fg="#818cf8",
            bg="#1e293b",
        ).pack(anchor="w")

        tk.Label(
            header,
            text="Ordenamiento externo de IDs de pedidos mediante particiones de tamano 1, 2, 4, 8... en archivos auxiliares F1 y F2. Solo enteros >= 0.",
            font=("Segoe UI", 9),
            fg="#cbd5e1",
            bg="#1e293b",
        ).pack(anchor="w", pady=(2, 0))

        panel_inputs = tk.Frame(self.root, bg="#0f172a", padx=20, pady=10)
        panel_inputs.pack(fill="x")

        fila_f = tk.Frame(panel_inputs, bg="#0f172a")
        fila_f.pack(fill="x", pady=3)
        tk.Label(
            fila_f,
            text="IDs de Pedidos (enteros >= 0):",
            font=("Segoe UI", 10, "bold"),
            fg="#e2e8f0",
            bg="#0f172a",
            width=26,
            anchor="w",
        ).pack(side="left")
        self.entry_datos = tk.Entry(
            fila_f,
            font=("Consolas", 11),
            bg="#1e293b",
            fg="#f8fafc",
            insertbackground="#818cf8",
            relief="flat",
            bd=6,
        )
        self.entry_datos.pack(side="left", fill="x", expand=True)

        panel_botones = tk.Frame(self.root, bg="#0f172a", padx=20, pady=6)
        panel_botones.pack(fill="x")

        estilo_btn = {"font": ("Segoe UI", 9, "bold"), "relief": "flat", "padx": 12, "pady": 6, "cursor": "hand2"}

        tk.Button(panel_botones, text="Cargar Datos", bg="#4f46e5", fg="white", command=self.cargar_manual, **estilo_btn).pack(side="left", padx=(0, 6))
        tk.Button(panel_botones, text="Ejemplo", bg="#334155", fg="white", command=self.cargar_ejemplo, **estilo_btn).pack(side="left", padx=6)
        tk.Button(panel_botones, text="Aleatorios", bg="#334155", fg="white", command=self.cargar_aleatorios, **estilo_btn).pack(side="left", padx=6)

        ttk.Separator(panel_botones, orient="vertical").pack(side="left", fill="y", padx=10)

        tk.Button(panel_botones, text="< Anterior", bg="#475569", fg="white", command=self.paso_anterior, **estilo_btn).pack(side="left", padx=4)
        tk.Button(panel_botones, text="Siguiente >", bg="#10b981", fg="#0f172a", command=self.paso_siguiente, **estilo_btn).pack(side="left", padx=4)
        self.btn_auto = tk.Button(panel_botones, text="Auto Ejecutar", bg="#6366f1", fg="white", command=self.alternar_auto, **estilo_btn)
        self.btn_auto.pack(side="left", padx=4)
        tk.Button(panel_botones, text="Completar", bg="#f59e0b", fg="#0f172a", command=self.ir_final, **estilo_btn).pack(side="left", padx=4)
        tk.Button(panel_botones, text="Reiniciar", bg="#ef4444", fg="white", command=self.reiniciar, **estilo_btn).pack(side="left", padx=4)

        panel_metricas = tk.Frame(self.root, bg="#1e293b", padx=20, pady=8)
        panel_metricas.pack(fill="x", padx=20, pady=6)

        self.lbl_paso = tk.Label(panel_metricas, text="Paso: 0 / 0", font=("Segoe UI", 10, "bold"), fg="#818cf8", bg="#1e293b")
        self.lbl_paso.pack(side="left", padx=(0, 22))

        self.lbl_bloque = tk.Label(panel_metricas, text="Bloque: -", font=("Segoe UI", 10, "bold"), fg="#38bdf8", bg="#1e293b")
        self.lbl_bloque.pack(side="left", padx=(0, 22))

        self.lbl_comp = tk.Label(panel_metricas, text="Comparaciones: 0", font=("Segoe UI", 10, "bold"), fg="#fbbf24", bg="#1e293b")
        self.lbl_comp.pack(side="left", padx=(0, 22))

        self.lbl_tiempo = tk.Label(panel_metricas, text="Tiempo: 0.0000 ms", font=("Segoe UI", 10, "bold"), fg="#34d399", bg="#1e293b")
        self.lbl_tiempo.pack(side="left", padx=(0, 22))

        self.lbl_estado = tk.Label(panel_metricas, text="Listo", font=("Segoe UI", 10, "bold"), fg="#a7f3d0", bg="#1e293b")
        self.lbl_estado.pack(side="right")

        self.canvas = tk.Canvas(self.root, bg="#1e293b", height=305, highlightthickness=1, highlightbackground="#334155")
        self.canvas.pack(fill="x", padx=20, pady=6)
        self.canvas.bind("<Configure>", lambda e: self.renderizar_paso())

        frame_log = tk.Frame(self.root, bg="#0f172a", padx=20, pady=4)
        frame_log.pack(fill="both", expand=True)

        tk.Label(frame_log, text="Bitacora de Particiones y Fusiones:", font=("Segoe UI", 9, "bold"), fg="#94a3b8", bg="#0f172a").pack(anchor="w")

        self.txt_log = tk.Text(
            frame_log,
            height=6,
            font=("Consolas", 10),
            bg="#020617",
            fg="#e2e8f0",
            relief="flat",
            padx=10,
            pady=8,
            state="disabled",
        )
        self.txt_log.pack(fill="both", expand=True, pady=(2, 10))

    def parsear_no_negativos(self, texto):
        partes = [p.strip() for p in texto.split(",") if p.strip()]
        if not partes:
            raise ValueError("Debes ingresar al menos un numero entero.")
        numeros = []
        for p in partes:
            try:
                num = int(p)
            except ValueError:
                raise ValueError(f"Valor invalido '{p}'. Solo se aceptan numeros enteros.")
            if num < 0:
                raise ValueError(f"No se aceptan numeros negativos ({num}). Ingresa valores >= 0.")
            numeros.append(num)
        return numeros

    def generar_pasos(self, datos):
        archivo_f = list(datos)
        n = len(archivo_f)
        pasos = []
        comparaciones = 0

        inicio = time.perf_counter()
        pasos.append({
            "f": list(archivo_f),
            "f1": [],
            "f2": [],
            "particion": 0,
            "comparaciones": 0,
            "fase": "inicial",
            "mensaje": f"Archivo original F cargado con {n} registros: {archivo_f}",
            "completado": n <= 1,
        })

        particion = 1
        pasada = 1
        while particion < n:
            f1 = []
            f2 = []
            indice = 0
            alternar = True
            while indice < n:
                bloque = archivo_f[indice:indice + particion]
                if alternar:
                    f1.extend(bloque)
                else:
                    f2.extend(bloque)
                alternar = not alternar
                indice += particion

            pasos.append({
                "f": list(archivo_f),
                "f1": list(f1),
                "f2": list(f2),
                "particion": particion,
                "comparaciones": comparaciones,
                "fase": "particion",
                "mensaje": f"Pasada {pasada} (Particion): Divide F en bloques de tamano {particion} -> F1={f1} | F2={f2}",
                "completado": False,
            })

            nuevo_f = []
            i = 0
            j = 0
            while i < len(f1) or j < len(f2):
                limite_i = min(i + particion, len(f1))
                limite_j = min(j + particion, len(f2))
                while i < limite_i and j < limite_j:
                    comparaciones += 1
                    if f1[i] <= f2[j]:
                        nuevo_f.append(f1[i])
                        i += 1
                    else:
                        nuevo_f.append(f2[j])
                        j += 1
                while i < limite_i:
                    nuevo_f.append(f1[i])
                    i += 1
                while j < limite_j:
                    nuevo_f.append(f2[j])
                    j += 1

            archivo_f = nuevo_f
            pasos.append({
                "f": list(archivo_f),
                "f1": list(f1),
                "f2": list(f2),
                "particion": particion,
                "comparaciones": comparaciones,
                "fase": "fusion",
                "mensaje": f"Pasada {pasada} (Fusion): Mezcla pares de bloques ordenados hacia F -> {archivo_f}",
                "completado": False,
            })

            particion *= 2
            pasada += 1

        self.tiempo_ms = (time.perf_counter() - inicio) * 1000
        pasos.append({
            "f": list(archivo_f),
            "f1": [],
            "f2": [],
            "particion": particion,
            "comparaciones": comparaciones,
            "fase": "final",
            "mensaje": f"Mezcla Directa finalizada. Archivo F ordenado: {archivo_f}",
            "completado": True,
        })
        return pasos

    def inicializar_datos(self, datos):
        self.detener_auto()
        self.pasos = self.generar_pasos(datos)
        self.indice_paso = 0
        self.lbl_tiempo.config(text=f"Tiempo: {self.tiempo_ms:.4f} ms")
        self.renderizar_paso()

    def cargar_manual(self):
        try:
            datos = self.parsear_no_negativos(self.entry_datos.get())
            self.inicializar_datos(datos)
        except ValueError as err:
            messagebox.showerror("Entrada no valida", str(err))

    def cargar_ejemplo(self):
        pedidos = [482, 119, 905, 340, 215, 760, 108, 623]
        self.entry_datos.delete(0, tk.END)
        self.entry_datos.insert(0, ", ".join(map(str, pedidos)))
        self.inicializar_datos(pedidos)

    def cargar_aleatorios(self):
        pedidos = random.sample(range(10, 999), 8)
        self.entry_datos.delete(0, tk.END)
        self.entry_datos.insert(0, ", ".join(map(str, pedidos)))
        self.inicializar_datos(pedidos)

    def dibujar_fila_bloques(self, titulo, datos, y_top, tam_bloque, color_borde, color_fondo):
        ancho_canvas = max(self.canvas.winfo_width(), 860)
        self.canvas.create_text(24, y_top, text=titulo, anchor="w", font=("Segoe UI", 10, "bold"), fill="#94a3b8")

        n = len(datos)
        if n == 0:
            self.canvas.create_text(24, y_top + 28, text="[ Sin registros en esta fase ]", anchor="w", font=("Consolas", 10), fill="#64748b")
            return

        margen = 24
        espacio = 8
        disponible = ancho_canvas - 2 * margen
        ancho_caja = min(64, max(34, (disponible - (n - 1) * espacio) // n))
        alto_caja = 36

        for idx, val in enumerate(datos):
            x1 = margen + idx * (ancho_caja + espacio)
            y1 = y_top + 14
            x2 = x1 + ancho_caja
            y2 = y1 + alto_caja

            grupo = (idx // tam_bloque) if tam_bloque > 0 else 0
            relleno = color_fondo if grupo % 2 == 0 else "#1e293b"

            self.canvas.create_rectangle(x1, y1, x2, y2, fill=relleno, outline=color_borde, width=2)
            self.canvas.create_text((x1 + x2) / 2, (y1 + y2) / 2, text=str(val), font=("Consolas", 11, "bold"), fill="#f8fafc")

    def renderizar_paso(self):
        if not self.pasos:
            return
        estado = self.pasos[self.indice_paso]
        self.canvas.delete("all")

        part = estado["particion"]
        bloque_f = part * 2 if estado["fase"] == "fusion" else part
        self.dibujar_fila_bloques("Archivo Principal F:", estado["f"], 18, bloque_f, "#34d399" if estado["completado"] else "#38bdf8", "#0f172a")
        self.dibujar_fila_bloques("Archivo Auxiliar F1:", estado["f1"], 112, part, "#818cf8", "#1e1b4b")
        self.dibujar_fila_bloques("Archivo Auxiliar F2:", estado["f2"], 206, part, "#fbbf24", "#451a03")

        total = len(self.pasos) - 1
        self.lbl_paso.config(text=f"Paso: {self.indice_paso} / {total}")
        self.lbl_bloque.config(text=f"Bloque: {part if part > 0 else '-'}")
        self.lbl_comp.config(text=f"Comparaciones: {estado['comparaciones']}")

        if estado["completado"]:
            self.lbl_estado.config(text="Ordenado", fg="#34d399")
        else:
            self.lbl_estado.config(text=f"Fase: {estado['fase'].capitalize()}", fg="#fbbf24")

        self.txt_log.config(state="normal")
        self.txt_log.delete("1.0", tk.END)
        for idx in range(self.indice_paso + 1):
            self.txt_log.insert(tk.END, f"[Paso {idx}] {self.pasos[idx]['mensaje']}\n")
        self.txt_log.see(tk.END)
        self.txt_log.config(state="disabled")

    def paso_siguiente(self):
        if self.indice_paso < len(self.pasos) - 1:
            self.indice_paso += 1
            self.renderizar_paso()
        else:
            self.detener_auto()

    def paso_anterior(self):
        self.detener_auto()
        if self.indice_paso > 0:
            self.indice_paso -= 1
            self.renderizar_paso()

    def ir_final(self):
        self.detener_auto()
        if self.pasos:
            self.indice_paso = len(self.pasos) - 1
            self.renderizar_paso()

    def reiniciar(self):
        self.detener_auto()
        self.indice_paso = 0
        self.renderizar_paso()

    def alternar_auto(self):
        if self.ejecutando_auto:
            self.detener_auto()
        else:
            if self.indice_paso >= len(self.pasos) - 1:
                self.indice_paso = 0
            self.ejecutando_auto = True
            self.btn_auto.config(text="Pausar", bg="#ec4899")
            self.ciclo_auto()

    def ciclo_auto(self):
        if not self.ejecutando_auto:
            return
        if self.indice_paso < len(self.pasos) - 1:
            self.indice_paso += 1
            self.renderizar_paso()
            self.after_id = self.root.after(750, self.ciclo_auto)
        else:
            self.detener_auto()

    def detener_auto(self):
        self.ejecutando_auto = False
        self.btn_auto.config(text="Auto Ejecutar", bg="#6366f1")
        if self.after_id is not None:
            self.root.after_cancel(self.after_id)
            self.after_id = None


if __name__ == "__main__":
    ventana = tk.Tk()
    app = AppMezclaDirecta(ventana)
    ventana.mainloop()
