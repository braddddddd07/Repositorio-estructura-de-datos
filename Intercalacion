        self.btn_auto = tk.Button(panel_botones, text="Auto Ejecutar", bg="#6366f1", fg="white", command=self.alternar_auto, **estilo_btn)
        self.btn_auto.pack(side="left", padx=4)
        tk.Button(panel_botones, text="Completar", bg="#f59e0b", fg="#0f172a", command=self.ir_final, **estilo_btn).pack(side="left", padx=4)
        tk.Button(panel_botones, text="Reiniciar", bg="#ef4444", fg="white", command=self.reiniciar, **estilo_btn).pack(side="left", padx=4)

        panel_metricas = tk.Frame(self.root, bg="#1e293b", padx=20, pady=8)
        panel_metricas.pack(fill="x", padx=20, pady=6)

        self.lbl_paso = tk.Label(panel_metricas, text="Paso: 0 / 0", font=("Segoe UI", 10, "bold"), fg="#38bdf8", bg="#1e293b")
        self.lbl_paso.pack(side="left", padx=(0, 25))

