import tkinter as tk
from tkinter import messagebox, simpledialog

class AppBusquedaSecuencial:
    def __init__(self, root):
        self.root = root
        self.root.title("Busqueda Secuencial - Registro de Ventas")
        self.root.geometry("880x500")
        self.root.configure(bg="#F8FAFC")

        self.datos_iniciales = ["Leche", "Pan", "Huevos", "Arroz", "Frijol", "Aceite", "Azucar", "Cafe"]
        self.ventas = list(self.datos_iniciales)
        self.cajas = []
        self.ejecutando = False

        self.crear_menu()
        self.crear_widgets()
        self.dibujar_lista()

    def crear_menu(self):
        barra_menu = tk.Menu(self.root)
        menu_opciones = tk.Menu(barra_menu, tearoff=0)
        menu_opciones.add_command(label="Buscar producto", command=self.buscar_desde_menu)
        menu_opciones.add_command(label="Registrar nueva venta", command=self.agregar_desde_menu)
        menu_opciones.add_command(label="Eliminar venta", command=self.eliminar_desde_menu)
        menu_opciones.add_command(label="Restaurar lista inicial", command=self.reiniciar_datos)
        menu_opciones.add_separator()
        menu_opciones.add_command(label="Salir", command=self.root.quit)
        barra_menu.add_cascade(label="Menu", menu=menu_opciones)
        self.root.config(menu=barra_menu)

    def crear_widgets(self):
        titulo = tk.Label(
            self.root,
            text="Busqueda Secuencial: Registro de Ventas del Dia",
            font=("Segoe UI", 14, "bold"),
            bg="#F8FAFC",
            fg="#0F172A"
        )
        titulo.pack(pady=(12, 6))

        frame_controles = tk.Frame(self.root, bg="#F8FAFC")
        frame_controles.pack(pady=6)

        tk.Label(frame_controles, text="Producto:", font=("Segoe UI", 10), bg="#F8FAFC").grid(row=0, column=0, padx=5)
        self.entry_producto = tk.Entry(frame_controles, font=("Segoe UI", 10), width=20)
        self.entry_producto.grid(row=0, column=1, padx=5)

        btn_buscar = tk.Button(
            frame_controles,
            text="Buscar Paso a Paso",
            font=("Segoe UI", 10, "bold"),
            bg="#2563EB",
            fg="white",
            command=self.iniciar_busqueda
        )
        btn_buscar.grid(row=0, column=2, padx=4)

        btn_agregar = tk.Button(
            frame_controles,
            text="Agregar Venta",
            font=("Segoe UI", 10),
            bg="#0D9488",
            fg="white",
            command=self.agregar_producto
        )
        btn_agregar.grid(row=0, column=3, padx=4)

        btn_eliminar = tk.Button(
            frame_controles,
            text="Eliminar Venta",
            font=("Segoe UI", 10),
            bg="#DC2626",
            fg="white",
            command=self.eliminar_producto
        )
        btn_eliminar.grid(row=0, column=4, padx=4)

        btn_limpiar = tk.Button(
            frame_controles,
            text="Limpiar Vista",
            font=("Segoe UI", 10),
            bg="#64748B",
            fg="white",
            command=self.limpiar_vista
        )
        btn_limpiar.grid(row=0, column=5, padx=4)

        self.frame_lista = tk.Frame(self.root, bg="#F8FAFC")
        self.frame_lista.pack(pady=15)

        lbl_log = tk.Label(
            self.root,
            text="Registro de ejecucion paso a paso:",
            font=("Segoe UI", 10, "bold"),
            bg="#F8FAFC",
            fg="#334155"
        )
        lbl_log.pack(anchor="w", padx=25)

        self.log_text = tk.Text(self.root, height=12, font=("Consolas", 10), bg="#0F172A", fg="#E2E8F0", padx=10, pady=10)
        self.log_text.pack(fill="both", expand=True, padx=25, pady=(4, 15))

    def dibujar_lista(self):
        for widget in self.frame_lista.winfo_children():
            widget.destroy()
        self.cajas = []

        for i, item in enumerate(self.ventas):
            tarjeta = tk.Frame(self.frame_lista, bg="#E0E7FF", bd=1, relief="solid", width=85, height=65)
            tarjeta.pack_propagate(False)
            tarjeta.grid(row=i // 8, column=i % 8, padx=4, pady=4)

            lbl_idx = tk.Label(tarjeta, text=f"Indice [{i}]", font=("Segoe UI", 8), bg="#E0E7FF", fg="#475569")
            lbl_idx.pack(pady=(4, 0))

            lbl_val = tk.Label(tarjeta, text=item, font=("Segoe UI", 10, "bold"), bg="#E0E7FF", fg="#1E293B")
            lbl_val.pack(pady=(2, 4))

            self.cajas.append((tarjeta, lbl_idx, lbl_val))

    def colorear_caja(self, indice, color):
        tarjeta, lbl_idx, lbl_val = self.cajas[indice]
        tarjeta.configure(bg=color)
        lbl_idx.configure(bg=color)
        lbl_val.configure(bg=color)

    def escribir_log(self, mensaje):
        self.log_text.insert(tk.END, mensaje + "\n")
        self.log_text.see(tk.END)

    def limpiar_vista(self):
        if self.ejecutando:
            return
        self.dibujar_lista()
        self.log_text.delete("1.0", tk.END)

    def reiniciar_datos(self):
        if self.ejecutando:
            return
        self.ventas = list(self.datos_iniciales)
        self.limpiar_vista()
        self.escribir_log("Lista restaurada a los valores iniciales.")

    def producto_existe(self, nombre):
        for item in self.ventas:
            if item.lower() == nombre.lower():
                return True
        return False

    def agregar_producto(self):
        if self.ejecutando:
            return
        nuevo = self.entry_producto.get().strip()
        if not nuevo:
            messagebox.showwarning("Aviso", "Escribe el nombre de un producto en el cuadro de texto.")
            return
        if self.producto_existe(nuevo):
            messagebox.showwarning("Producto duplicado", f"El producto '{nuevo}' ya se encuentra en el registro.")
            self.escribir_log(f"Registro rechazado: '{nuevo}' ya existe en la lista (no se permiten repetidos).")
            return
        self.ventas.append(nuevo)
        self.entry_producto.delete(0, tk.END)
        self.dibujar_lista()
        self.escribir_log(f"Producto '{nuevo}' agregado al final de la lista en el indice [{len(self.ventas) - 1}].")

    def agregar_desde_menu(self):
        if self.ejecutando:
            return
        nuevo = simpledialog.askstring("Registrar Venta", "Ingresa el nombre del producto vendido:")
        if nuevo and nuevo.strip():
            limpio = nuevo.strip()
            if self.producto_existe(limpio):
                messagebox.showwarning("Producto duplicado", f"El producto '{limpio}' ya se encuentra en el registro.")
                self.escribir_log(f"Registro rechazado: '{limpio}' ya existe en la lista (no se permiten repetidos).")
                return
            self.ventas.append(limpio)
            self.dibujar_lista()
            self.escribir_log(f"Producto '{limpio}' agregado al final de la lista en el indice [{len(self.ventas) - 1}].")

    def procesar_eliminacion(self, nombre):
        for i, item in enumerate(self.ventas):
            if item.lower() == nombre.lower():
                eliminado = self.ventas.pop(i)
                self.dibujar_lista()
                self.escribir_log(f"Producto '{eliminado}' eliminado del registro (estaba en el indice [{i}]).")
                return
        messagebox.showinfo("No encontrado", f"El producto '{nombre}' no existe en el registro.")
        self.escribir_log(f"Eliminacion fallida: '{nombre}' no se encuentra en la lista.")

    def eliminar_producto(self):
        if self.ejecutando:
            return
        objetivo = self.entry_producto.get().strip()
        if not objetivo:
            messagebox.showwarning("Aviso", "Escribe el nombre del producto que deseas eliminar.")
            return
        self.entry_producto.delete(0, tk.END)
        self.procesar_eliminacion(objetivo)

    def eliminar_desde_menu(self):
        if self.ejecutando:
            return
        objetivo = simpledialog.askstring("Eliminar Venta", "Ingresa el nombre del producto a eliminar:")
        if objetivo and objetivo.strip():
            self.procesar_eliminacion(objetivo.strip())

    def buscar_desde_menu(self):
        if self.ejecutando:
            return
        objetivo = simpledialog.askstring("Buscar Producto", "Ingresa el producto a buscar:")
        if objetivo and objetivo.strip():
            self.entry_producto.delete(0, tk.END)
            self.entry_producto.insert(0, objetivo.strip())
            self.iniciar_busqueda()

    def iniciar_busqueda(self):
        if self.ejecutando:
            return
        objetivo = self.entry_producto.get().strip()
        if not objetivo:
            messagebox.showwarning("Aviso", "Ingresa un producto para buscar.")
            return

        self.ejecutando = True
        self.dibujar_lista()
        self.log_text.delete("1.0", tk.END)
        self.escribir_log(f"Iniciando busqueda secuencial para: '{objetivo}' (Total elementos: {len(self.ventas)})")
        self.escribir_log("-" * 65)
        self.paso_busqueda(0, objetivo)

    def paso_busqueda(self, indice, objetivo):
        if indice >= len(self.ventas):
            self.escribir_log(f"Paso {indice + 1}: Se alcanzo el final de la lista sin coincidencias.")
            self.escribir_log(f"RESULTADO: '{objetivo}' no se encuentra registrado.")
            self.ejecutando = False
            return

        self.colorear_caja(indice, "#FACC15")
        actual = self.ventas[indice]
        self.escribir_log(f"Paso {indice + 1}: Revisando indice [{indice}] -> '{actual}'...")
        self.root.after(700, lambda: self.evaluar_elemento(indice, objetivo))

    def evaluar_elemento(self, indice, objetivo):
        actual = self.ventas[indice]
        if actual.lower() == objetivo.lower():
            self.colorear_caja(indice, "#4ADE80")
            self.escribir_log(f"   -> COINCIDENCIA: '{actual}' == '{objetivo}'. Encontrado en posicion {indice}.")
            self.ejecutando = False
        else:
            self.colorear_caja(indice, "#FCA5A5")
            self.escribir_log(f"   -> No coincide ('{actual}' != '{objetivo}'). Avanzando al siguiente indice...")
            self.root.after(450, lambda: self.paso_busqueda(indice + 1, objetivo))

if __name__ == "__main__":
    root = tk.Tk()
    app = AppBusquedaSecuencial(root)
    root.mainloop()
