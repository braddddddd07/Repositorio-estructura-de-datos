  def _renderizar_paso(self):
    paso = self.pasos[self.indice_actual]
    arr = paso["array"]
    colores = paso["colores"]
    n = len(arr)

    self.lbl_contador.config(text=f"Paso {self.indice_actual + 1} / {len(self.pasos)}")
    self.lbl_explicacion.config(text=paso["texto"])
    self.lbl_info_extra.config(text=paso.get("info", ""))

    self.canvas.delete("all")
    w_canvas = 820
    tiene_cubetas = "cubetas" in paso
    h_zona_barras = 200 if tiene_cubetas else 315

    margen_x = 35
    ancho_disponible = w_canvas - 2 * margen_x
    paso_x = ancho_disponible / max(n, 1)
    ancho_barra = min(56, paso_x * 0.72)

    valores = [item.valor for item in arr]
    min_val = min(valores) if valores else 0.0
    max_val = max(valores) if valores else 1.0
    rango_val = max_val - min_val if not math.isclose(max_val, min_val) else 1.0

    base_y = h_zona_barras - 28
    max_altura_barra = h_zona_barras - 65

    for idx, item in enumerate(arr):
      centro_x = margen_x + paso_x * idx + paso_x / 2
      x0 = centro_x - ancho_barra / 2
      x1 = centro_x + ancho_barra / 2

      altura = 24 + ((item.valor - min_val) / rango_val) * (max_altura_barra - 24)
      y0 = base_y - altura
      y1 = base_y

      color_barra = colores.get(idx, "#3b82f6")

      self.canvas.create_rectangle(
          x0, y0, x1, y1, fill=color_barra, outline="#1e293b", width=1
      )

      fuente_val = ("Segoe UI", 9, "bold") if n <= 16 else ("Segoe UI", 8, "bold")
      self.canvas.create_text(
          centro_x, y0 - 11, text=item.texto, font=fuente_val, fill="#0f172a"
      )

      if n <= 24:
        self.canvas.create_text(
            centro_x,
            base_y + 13,
            text=f"[{idx}]",
            font=("Consolas", 8),
            fill="#64748b",
        )

    if tiene_cubetas:
      cubetas = paso["cubetas"]
      claves = list(cubetas.keys())
      num_c = len(claves)
      y_top_cubeta = 225
      y_bot_cubeta = 340
      ancho_c = (w_canvas - 30) / num_c

      self.canvas.create_line(
          15, y_top_cubeta - 12, w_canvas - 15, y_top_cubeta - 12, fill="#cbd5e1"
      )

      for i, k in enumerate(claves):
        cx0 = 15 + i * ancho_c + 1
        cx1 = 15 + (i + 1) * ancho_c - 1
        cmid = (cx0 + cx1) / 2

        self.canvas.create_rectangle(
            cx0,
            y_top_cubeta,
            cx1,
            y_bot_cubeta,
            fill="#f8fafc",
            outline="#94a3b8",
        )
        self.canvas.create_rectangle(
            cx0,
            y_bot_cubeta - 20,
            cx1,
            y_bot_cubeta,
            fill="#1e3a5f",
            outline="#1e3a5f",
        )
        self.canvas.create_text(
            cmid,
            y_bot_cubeta - 10,
            text=str(k),
            font=("Segoe UI", 8, "bold"),
            fill="white",
        )

        contenido = "\n".join(x.texto for x in cubetas[k][-4:])
        self.canvas.create_text(
            cmid,
            (y_top_cubeta + y_bot_cubeta - 20) / 2,
            text=contenido,
            font=("Consolas", 7, "bold"),
            fill="#0f172a",
        )

    self.btn_inicio.config(state="normal" if self.indice_actual > 0 else "disabled")
    self.btn_anterior.config(state="normal" if self.indice_actual > 0 else "disabled")
    self.btn_siguiente.config(
        state="normal" if self.indice_actual < len(self.pasos) - 1 else "disabled"
    )
    self.btn_final.config(
        state="normal" if self.indice_actual < len(self.pasos) - 1 else "disabled"
    )

  def ir_inicio(self):
    self._detener_auto()
    self.indice_actual = 0
    self._renderizar_paso()

  def ir_final(self):
    self._detener_auto()
    self.indice_actual = len(self.pasos) - 1
    self._renderizar_paso()

  def paso_anterior(self):
    self._detener_auto()
    if self.indice_actual > 0:
      self.indice_actual -= 1
      self._renderizar_paso()

  def paso_siguiente(self):
    if self.indice_actual < len(self.pasos) - 1:
      self.indice_actual += 1
      self._renderizar_paso()
    else:
      self._detener_auto()

  def alternar_reproduccion(self):
    if self.reproduciendo:
      self._detener_auto()
    else:
      if self.indice_actual >= len(self.pasos) - 1:
        self.indice_actual = 0
      self.reproduciendo = True
      self.btn_play.config(text="⏸ Pausar", bg="#d97706")
      self._ciclo_auto()

  def _ciclo_auto(self):
    if not self.reproduciendo:
      return
    if self.indice_actual < len(self.pasos) - 1:
      self.indice_actual += 1
      self._renderizar_paso()
      retardos = {"Lenta": 1100, "Normal": 600, "Rápida": 220}
      ms = retardos.get(self.velocidad_var.get(), 600)
      self.after_id = self.after(ms, self._ciclo_auto)
    else:
      self._detener_auto()

  def _detener_auto(self):
    self.reproduciendo = False
    if self.after_id:
      self.after_cancel(self.after_id)
      self.after_id = None
    self.btn_play.config(text="⏯ Reproducir", bg="#059669")

  def cerrar_ventana(self):
    self._detener_auto()
    self.destroy()


class OrdenamientoApp:

