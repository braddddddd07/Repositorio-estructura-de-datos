  def _obtener_cantidad(self):
    texto = self.entry_cantidad.get().strip()
    if not texto.isdigit() or int(texto) <= 0:
      raise ValueError("Ingresa una cantidad de números válida (entero mayor a 0).")
    return int(texto)

  def _obtener_lista_numeros(self):
    n = self._obtener_cantidad()
    raw_nums = self.entry_numeros.get().strip()
    if not raw_nums:
      raise ValueError("Debes ingresar los números a ordenar.")

    partes = raw_nums.replace(",", " ").split()
    if len(partes) != n:
      raise ValueError(
          f"Indicaste {n} números, pero ingresaste {len(partes)}.\n"
          "Asegúrate de que coincidan."
      )

    return [parsear_numero(p) for p in partes]

  def capturar_uno_por_uno(self):
    try:
      n = self._obtener_cantidad()
      numeros = []
      for i in range(1, n + 1):
        while True:
          val = simpledialog.askstring(
              "Ingreso de números",
              f"Ingresa el número {i} de {n}\n(ej. -8, 3/4, √5, -sqrt(2), 15):",
              parent=self.root,
          )
          if val is None:
            return
          try:
            dato = parsear_numero(val)
            numeros.append(dato.texto)
            break
          except ValueError as err:
            messagebox.showwarning("Valor inválido", str(err), parent=self.root)

      self.entry_numeros.delete(0, tk.END)
      self.entry_numeros.insert(0, ", ".join(numeros))
    except ValueError as e:
      messagebox.showwarning("Dato inválido", str(e))

  def _crear_token_aleatorio(self, tipo):
    if tipo == "entero_neg":
      return str(random.randint(-25, -1))
    if tipo == "entero_pos":
      return str(random.randint(1, 25))
    if tipo == "fraccion":
      num = random.choice([i for i in range(-9, 10) if i != 0])
      den = random.choice([2, 3, 4, 5, 8])
      while num % den == 0:
        den = random.choice([2, 3, 4, 5, 8])
      return f"{num}/{den}"
    radicando = random.choice([2, 3, 5, 6, 7, 8, 10, 11, 13, 15, 20])
    signo = random.choice(["", "-"])
    coef = random.choice(["", "", "2"])
    return f"{signo}{coef}√{radicando}"

  def generar_aleatorios(self):
    try:
      n = self._obtener_cantidad()
      tipos_base = ["entero_neg", "fraccion", "raiz", "entero_pos"]
      seleccion = []

      for i in range(n):
        if i < len(tipos_base):
          tipo = tipos_base[i]
        else:
          tipo = random.choice(tipos_base)
        seleccion.append(self._crear_token_aleatorio(tipo))

      random.shuffle(seleccion)
      self.entry_numeros.delete(0, tk.END)
      self.entry_numeros.insert(0, ", ".join(seleccion))
    except ValueError as e:
      messagebox.showwarning("Dato inválido", str(e))

  def abrir_ventana_metodo(self, metodo, color_tema):
    try:
      numeros = self._obtener_lista_numeros()

      if metodo == "ShellSort":
        pasos = generar_pasos_shell(numeros)
        titulo = "1. ShellSort"
      elif metodo == "Quicksort":
        pasos = generar_pasos_quicksort(numeros)
        titulo = "2. Quicksort"
      elif metodo == "Heapsort":
        pasos = generar_pasos_heapsort(numeros)
        titulo = "3. Heapsort"
      elif metodo == "Radix":
        pasos = generar_pasos_radix(numeros)
        titulo = "4. Radix Sort"
      else:
        return

      VentanaPasoAPaso(self.root, titulo, color_tema, pasos)

    except ValueError as e:
      messagebox.showerror("Error de validación", str(e))

  def limpiar_campos(self):
    self.entry_cantidad.delete(0, tk.END)
    self.entry_numeros.delete(0, tk.END)
    self.entry_cantidad.focus()

  def salir_aplicacion(self):
    if messagebox.askyesno("Confirmar salida", "¿Deseas salir del programa de ordenamiento?"):
      self.root.destroy()


