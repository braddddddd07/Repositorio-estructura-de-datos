        )
        self.entry_f1.pack(side="left", fill="x", expand=True)

        fila_f2 = tk.Frame(panel_inputs, bg="#0f172a")
        fila_f2.pack(fill="x", pady=3)
        tk.Label(
            fila_f2,
            text="Archivo F2 (enteros >= 0):",
            font=("Segoe UI", 10, "bold"),
            fg="#e2e8f0",
            bg="#0f172a",
            width=24,
            anchor="w",
        ).pack(side="left")
        self.entry_f2 = tk.Entry(
            fila_f2,
            font=("Consolas", 11),
            bg="#1e293b",
            fg="#f8fafc",
            insertbackground="#38bdf8",
            relief="flat",
            bd=6,
        )
        self.entry_f2.pack(side="left", fill="x", expand=True)

        panel_botones = tk.Frame(self.root, bg="#0f172a", padx=20, pady=6)
        panel_botones.pack(fill="x")

        estilo_btn = {"font": ("Segoe UI", 9, "bold"), "relief": "flat", "padx": 12, "pady": 6, "cursor": "hand2"}

        tk.Button(panel_botones, text="Cargar Datos", bg="#0284c7", fg="white", command=self.cargar_manual, **estilo_btn).pack(side="left", padx=(0, 6))
        tk.Button(panel_botones, text="Ejemplo", bg="#334155", fg="white", command=self.cargar_ejemplo, **estilo_btn).pack(side="left", padx=6)
        tk.Button(panel_botones, text="Aleatorios", bg="#334155", fg="white", command=self.cargar_aleatorios, **estilo_btn).pack(side="left", padx=6)

        ttk.Separator(panel_botones, orient="vertical").pack(side="left", fill="y", padx=10)

