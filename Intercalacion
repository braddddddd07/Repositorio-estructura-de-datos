            state="disabled",
        )
        self.txt_log.pack(fill="both", expand=True, pady=(2, 10))

    def parsear_no_negativos(self, texto, nombre_campo):
        partes = [p.strip() for p in texto.split(",") if p.strip()]
        if not partes:
            raise ValueError(f"El campo {nombre_campo} no puede estar vacio.")
        numeros = []
        for p in partes:
            try:
                num = int(p)
            except ValueError:
                raise ValueError(f"Valor invalido '{p}' en {nombre_campo}. Solo se aceptan numeros enteros.")
            if num < 0:
                raise ValueError(f"No se aceptan numeros negativos ({num}) en {nombre_campo}.")
            numeros.append(num)
        return numeros

    def generar_pasos(self, lista_a, lista_b):
        f1 = sorted(lista_a)
        f2 = sorted(lista_b)
        pasos = []
        resultado = []
        i = 0
        j = 0
        comparaciones = 0

        inicio = time.perf_counter()
        pasos.append({
            "f1": list(f1),
            "f2": list(f2),
            "f": [],
            "i": 0,
            "j": 0,
            "comp_i": 0 if f1 else -1,
            "comp_j": 0 if f2 else -1,
            "ultimo_idx": -1,
            "comparaciones": 0,
            "mensaje": f"Archivos ordenados listos: F1={f1}, F2={f2}.",
            "completado": False,
        })

        while i < len(f1) and j < len(f2):
            comparaciones += 1
            if f1[i] <= f2[j]:
                elegido = f1[i]
                msg = f"Compara F1[{i}]={f1[i]} <= F2[{j}]={f2[j]} -> Inserta {elegido} desde F1."
                resultado.append(elegido)
                ci, cj = i, j
                i += 1
            else:
                elegido = f2[j]
                msg = f"Compara F1[{i}]={f1[i]} > F2[{j}]={f2[j]} -> Inserta {elegido} desde F2."
                resultado.append(elegido)
                ci, cj = i, j
                j += 1

            pasos.append({
                "f1": list(f1),
                "f2": list(f2),
                "f": list(resultado),
                "i": i,
                "j": j,
                "comp_i": ci,
                "comp_j": cj,
                "ultimo_idx": len(resultado) - 1,
                "comparaciones": comparaciones,
                "mensaje": msg,
                "completado": False,
            })

        while i < len(f1):
            elegido = f1[i]
            resultado.append(elegido)
            msg = f"F2 agotado -> Copia remanente F1[{i}]={elegido} al archivo maestro F."
            ci = i
            i += 1
            pasos.append({
                "f1": list(f1),
                "f2": list(f2),
                "f": list(resultado),
                "i": i,
                "j": j,
                "comp_i": ci,
                "comp_j": -1,
                "ultimo_idx": len(resultado) - 1,
                "comparaciones": comparaciones,
                "mensaje": msg,
                "completado": False,
            })

        while j < len(f2):
            elegido = f2[j]
            resultado.append(elegido)
            msg = f"F1 agotado -> Copia remanente F2[{j}]={elegido} al archivo maestro F."
            cj = j
            j += 1
            pasos.append({
                "f1": list(f1),
                "f2": list(f2),
                "f": list(resultado),
                "i": i,
                "j": j,
                "comp_i": -1,
                "comp_j": cj,
                "ultimo_idx": len(resultado) - 1,
                "comparaciones": comparaciones,
                "mensaje": msg,
                "completado": False,
            })

        self.tiempo_ms = (time.perf_counter() - inicio) * 1000
        pasos.append({
            "f1": list(f1),
            "f2": list(f2),
            "f": list(resultado),
            "i": i,
            "j": j,
            "comp_i": -1,
            "comp_j": -1,
            "ultimo_idx": -1,
            "comparaciones": comparaciones,
            "mensaje": f"Intercalacion finalizada. Archivo maestro F: {resultado}",
            "completado": True,
        })
        return pasos

    def inicializar_datos(self, f1, f2):
        self.detener_auto()
        self.pasos = self.generar_pasos(f1, f2)
        self.indice_paso = 0
        self.lbl_tiempo.config(text=f"Tiempo: {self.tiempo_ms:.4f} ms")
        self.renderizar_paso()

    def cargar_manual(self):
        try:
            f1 = self.parsear_no_negativos(self.entry_f1.get(), "Archivo F1")
            f2 = self.parsear_no_negativos(self.entry_f2.get(), "Archivo F2")
            self.inicializar_datos(f1, f2)
        except ValueError as err:
            messagebox.showerror("Entrada no valida", str(err))

    def cargar_ejemplo(self):
        f1 = [104, 215, 389, 512, 740, 890]
        f2 = [110, 198, 410, 512, 635, 920]
        self.entry_f1.delete(0, tk.END)
        self.entry_f1.insert(0, ", ".join(map(str, f1)))
        self.entry_f2.delete(0, tk.END)
        self.entry_f2.insert(0, ", ".join(map(str, f2)))
        self.inicializar_datos(f1, f2)

    def cargar_aleatorios(self):
        f1 = sorted(random.sample(range(10, 999), 6))
        f2 = sorted(random.sample(range(10, 999), 6))
        self.entry_f1.delete(0, tk.END)
        self.entry_f1.insert(0, ", ".join(map(str, f1)))
        self.entry_f2.delete(0, tk.END)
        self.entry_f2.insert(0, ", ".join(map(str, f2)))
        self.inicializar_datos(f1, f2)

    def dibujar_arreglo(self, titulo, datos, y_top, idx_activo=-1, idx_procesados=0, es_resultado=False, ultimo_idx=-1):
        ancho_canvas = max(self.canvas.winfo_width(), 860)
        self.canvas.create_text(24, y_top, text=titulo, anchor="w", font=("Segoe UI", 10, "bold"), fill="#94a3b8")

        n = len(datos)
        if n == 0:
            self.canvas.create_text(24, y_top + 28, text="[ Vacio ]", anchor="w", font=("Consolas", 10), fill="#64748b")
            return

        margen = 24
        espacio = 8
        disponible = ancho_canvas - 2 * margen
        ancho_caja = min(64, max(36, (disponible - (n - 1) * espacio) // n))
        alto_caja = 38

        for idx, val in enumerate(datos):
            x1 = margen + idx * (ancho_caja + espacio)
            y1 = y_top + 14
            x2 = x1 + ancho_caja
            y2 = y1 + alto_caja

            fill_color = "#0f172a"
            border_color = "#38bdf8"
            text_color = "#f8fafc"

            if es_resultado:
                if idx == ultimo_idx:
                    fill_color = "#065f46"
                    border_color = "#34d399"
                else:
                    fill_color = "#1e3a8a"
                    border_color = "#60a5fa"
            else:
                if idx == idx_activo:
                    fill_color = "#78350f"
                    border_color = "#fbbf24"
                elif idx < idx_procesados:
                    fill_color = "#1e293b"
                    border_color = "#475569"
                    text_color = "#64748b"

            self.canvas.create_rectangle(x1, y1, x2, y2, fill=fill_color, outline=border_color, width=2)
            self.canvas.create_text((x1 + x2) / 2, (y1 + y2) / 2, text=str(val), font=("Consolas", 11, "bold"), fill=text_color)

    def renderizar_paso(self):
        if not self.pasos:
            return
        estado = self.pasos[self.indice_paso]
        self.canvas.delete("all")

        self.dibujar_arreglo("Archivo F1 (Sucursal Norte):", estado["f1"], 18, idx_activo=estado["comp_i"], idx_procesados=estado["i"])
        self.dibujar_arreglo("Archivo F2 (Sucursal Sur):", estado["f2"], 108, idx_activo=estado["comp_j"], idx_procesados=estado["j"])
        self.dibujar_arreglo("Archivo Maestro F (Consolidado):", estado["f"], 202, es_resultado=True, ultimo_idx=estado["ultimo_idx"])

        total = len(self.pasos) - 1
        self.lbl_paso.config(text=f"Paso: {self.indice_paso} / {total}")
        self.lbl_comp.config(text=f"Comparaciones: {estado['comparaciones']}")

        if estado["completado"]:
            self.lbl_estado.config(text="Completado", fg="#34d399")
        else:
            self.lbl_estado.config(text="En proceso", fg="#fbbf24")

        self.txt_log.config(state="normal")
        self.txt_log.delete("1.0", tk.END)
        for idx in range(self.indice_paso + 1):
            prefijo = f"[Paso {idx}] "
            self.txt_log.insert(tk.END, prefijo + self.pasos[idx]["mensaje"] + "\n")
        self.txt_log.see(tk.END)
        self.txt_log.config(state="disabled")

    def paso_siguiente(self):
        if self.indice_paso < len(self.pasos) - 1:
            self.indice_paso += 1
            self.renderizar_paso()
        else:
            self.detener_auto()

    def paso_anterior(self):
        self.detener_auto()
        if self.indice_paso > 0:
            self.indice_paso -= 1
            self.renderizar_paso()

    def ir_final(self):
        self.detener_auto()
        if self.pasos:
            self.indice_paso = len(self.pasos) - 1
            self.renderizar_paso()

    def reiniciar(self):
        self.detener_auto()
        self.indice_paso = 0
        self.renderizar_paso()

    def alternar_auto(self):
        if self.ejecutando_auto:
            self.detener_auto()
        else:
            if self.indice_paso >= len(self.pasos) - 1:
                self.indice_paso = 0
            self.ejecutando_auto = True
            self.btn_auto.config(text="Pausar", bg="#ec4899")
            self.ciclo_auto()

    def ciclo_auto(self):
        if not self.ejecutando_auto:
            return
        if self.indice_paso < len(self.pasos) - 1:
            self.indice_paso += 1
            self.renderizar_paso()
            self.after_id = self.root.after(650, self.ciclo_auto)
        else:
            self.detener_auto()

    def detener_auto(self):
        self.ejecutando_auto = False
        self.btn_auto.config(text="Auto Ejecutar", bg="#6366f1")
        if self.after_id is not None:
            self.root.after_cancel(self.after_id)
            self.after_id = None


if __name__ == "__main__":
    ventana = tk.Tk()
    app = AppIntercalacion(ventana)
    ventana.mainloop()
