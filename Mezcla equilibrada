import tkinter as tk
from tkinter import ttk, messagebox
import random
import time


class AppMezclaEquilibrada:
    def __init__(self, root):
        self.root = root
        self.root.title("Ejercicio 3: Ordenamiento por Mezcla Equilibrada")
        self.root.geometry("980x680")
        self.root.minsize(900, 620)
        self.root.configure(bg="#0f172a")

        self.pasos = []
        self.indice_paso = 0
        self.ejecutando_auto = False
        self.after_id = None
        self.tiempo_ms = 0.0

        self.construir_interfaz()
        self.cargar_ejemplo()

